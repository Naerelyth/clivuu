# CPack's External generator has already staged the common /usr install tree.
find_program(appimagetool NAMES "@CLIVUU_APPIMAGETOOL@" REQUIRED)
set(runtime "@CLIVUU_APPIMAGE_RUNTIME@")
if(NOT EXISTS "${runtime}" OR IS_DIRECTORY "${runtime}")
  message(FATAL_ERROR "Set CLIVUU_APPIMAGE_RUNTIME to a local type-2 runtime; no implicit network downloads")
endif()
file(READ "${runtime}" header LIMIT 20 HEX)
string(LENGTH "${header}" length)
if(length LESS 40)
  message(FATAL_ERROR "AppImage runtime is truncated")
endif()
string(SUBSTRING "${header}" 36 4 machine)
string(SUBSTRING "${header}" 16 6 marker)
if(NOT header MATCHES "^7f454c460201" OR NOT machine STREQUAL "@CLIVUU_ELF_MACHINE@" OR NOT marker STREQUAL "414902")
  message(FATAL_ERROR "Expected a type-2 AppImage runtime for @CLIVUU_ARCH@")
endif()
set(appdir "${CPACK_TEMPORARY_DIRECTORY}")
set(payload "${appdir}/usr")
file(GLOB_RECURSE files RELATIVE "${payload}" "${payload}/*")
list(SORT files)
set(identity "")
foreach(path IN LISTS files)
  if(NOT IS_DIRECTORY "${payload}/${path}")
    file(SHA256 "${payload}/${path}" hash)
    string(APPEND identity "${path}:${hash}\n")
  endif()
endforeach()
string(SHA256 PAYLOAD_ID "${identity}")
configure_file("@CMAKE_CURRENT_SOURCE_DIR@/packaging/AppRun.in" "${appdir}/AppRun" @ONLY)
file(CHMOD "${appdir}/AppRun" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
set(entry io.github.naerelyth.clivuu.desktop)
file(CREATE_LINK "usr/share/applications/${entry}" "${appdir}/${entry}" SYMBOLIC)
set(icon io.github.naerelyth.clivuu.svg)
file(CREATE_LINK "usr/share/icons/hicolor/scalable/apps/${icon}" "${appdir}/${icon}" SYMBOLIC)
file(CREATE_LINK "${icon}" "${appdir}/.DirIcon" SYMBOLIC)
set(image "${CPACK_PACKAGE_DIRECTORY}/clivuu-@CLIVUU_VERSION@-@CLIVUU_ARCH@.AppImage")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ARCH=@CLIVUU_ARCH@" "VERSION=@CLIVUU_VERSION@" "APPIMAGE_EXTRACT_AND_RUN=1"
  "${appimagetool}" --runtime-file "${runtime}" "${appdir}" "${image}"
  COMMAND_ERROR_IS_FATAL ANY)
set(CPACK_EXTERNAL_BUILT_PACKAGES "${image}")
