# Run at installation/packaging time, after Cargo has produced both executables.
foreach(name clivuu clivuu-desktop)
  set(binary "@CLIVUU_BIN_DIR@/${name}")
  if(NOT EXISTS "${binary}")
    message(FATAL_ERROR "Missing ${binary}; build the complete Rust application first")
  endif()
  file(READ "${binary}" header LIMIT 20 HEX)
  string(LENGTH "${header}" length)
  if(length LESS 40 OR NOT header MATCHES "^7f454c460201")
    message(FATAL_ERROR "Expected a 64-bit little-endian ELF: ${binary}")
  endif()
  string(SUBSTRING "${header}" 36 4 machine)
  if(NOT machine STREQUAL "@CLIVUU_ELF_MACHINE@")
    message(FATAL_ERROR "${binary} does not match the @CLIVUU_ARCH@ package architecture")
  endif()
endforeach()
